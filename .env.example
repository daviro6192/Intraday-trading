# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# --- Trading mode: "paper" (default, sicuro) o "live" (ordini reali) ---
TRADING_MODE=paper

# --- Interactive Brokers (ib_async) ---
# Porta paper trading di default (TWS: 7497, IB Gateway paper: 4002)
# Porta live va impostata esplicitamente solo con TRADING_MODE=live
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# --- Database ---
DATABASE_URL=sqlite:///./trading.db

# --- Logging ---
LOG_LEVEL=INFO

# --- Piattaforma web (api/) ---
# Chiave per firmare i cookie di sessione: generarne una propria, es. con
# `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=changeme-generate-a-real-random-secret
